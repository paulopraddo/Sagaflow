{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "MassTransit": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "PaymentGateway": {
    "DeclineAmountAbove": 1000,
    "RandomDeclineRate": 0,
    "Latency": "00:00:00.200"
  }
}
