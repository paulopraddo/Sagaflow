    <UserSecretsId>0e5f8e7b-8b7e-4968-ba52-2354da609847</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
